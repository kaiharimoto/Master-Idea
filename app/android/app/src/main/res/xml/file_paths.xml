<?xml version="1.0" encoding="utf-8"?>
<!--
  The one directory this app shares outward.

  `getTemporaryDirectory()` on Android is the cache directory, which is where
  the updater writes the APK it downloads and where a pitch is written before
  it is handed to another app. Nothing else is exposed: a provider over the
  whole of internal storage would hand every stored session — every interview
  answer the client gave — to any app holding the URI.
-->
<paths>
    <cache-path name="updates" path="updates/" />
    <cache-path name="handover" path="handover/" />
</paths>
