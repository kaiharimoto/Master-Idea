# Dart / Flutter
.dart_tool/
.packages
build/
# Locked for the application, ignored for the three packages — Dart's own
# guidance, and the reason it matters here: a build of one commit should be a
# build of one commit. With every dependency floating, a transitive publish
# between two CI runs changes what ships from the same source, which is the
# one thing the committed signing key and the build-number contract exist to
# make impossible.
packages/*/pubspec.lock
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local runtime state
*.log
/runs/
/.mp/

# Session output is committed deliberately (the reference sessions are
# evidence), but a scratch run is not.
/sessions/scratch-*/
